FROM alpine:3.21 AS build
RUN apk add --no-cache build-base cmake linux-headers curl tar bzip2
WORKDIR /deps
RUN curl -fsSL https://github.com/opencv/opencv/archive/refs/tags/4.10.0.tar.gz -o opencv.tar.gz \
 && echo 'b2171af5be6b26f7a06b1229948bbb2bdaa74fcf5cd097e0af6378fce50a6eb9  opencv.tar.gz' | sha256sum -c - \
 && tar -xzf opencv.tar.gz
RUN cmake -S opencv-4.10.0 -B opencv-build \
 -DCMAKE_BUILD_TYPE=MinSizeRel -DCMAKE_INSTALL_PREFIX=/opt/opencv \
 -DBUILD_SHARED_LIBS=OFF -DBUILD_LIST=core,imgproc,imgcodecs,dnn,objdetect \
 -DBUILD_opencv_gapi=OFF -DWITH_ADE=OFF \
 -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF \
 -DBUILD_opencv_apps=OFF -DBUILD_JAVA=OFF -DBUILD_opencv_python3=OFF \
 -DWITH_IPP=OFF -DWITH_ITT=OFF -DWITH_OPENCL=OFF -DWITH_TBB=OFF \
 -DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF -DWITH_GTK=OFF -DWITH_QT=OFF \
 -DWITH_TIFF=OFF -DWITH_WEBP=OFF -DWITH_OPENEXR=OFF -DWITH_JASPER=OFF \
 -DBUILD_JPEG=ON -DBUILD_PNG=ON -DBUILD_ZLIB=ON -DBUILD_PROTOBUF=ON \
 -DCPU_BASELINE=SSE2 -DCPU_DISPATCH= \
 && cmake --build opencv-build -j2 && cmake --install opencv-build
WORKDIR /src
COPY . .
RUN cmake -S apps/backend/engine -B build -DCMAKE_BUILD_TYPE=MinSizeRel \
 -DOpenCV_DIR=/opt/opencv/lib/cmake/opencv4 -DCMAKE_EXE_LINKER_FLAGS=-static -DFACE_LIBRARY_TESTS=ON \
 && cmake --build build -j2 && ctest --test-dir build --output-on-failure \
 && strip build/face-library build/make-fixtures build/orientation-test
FROM scratch AS binary
COPY --from=build /src/build/face-library /face-core
COPY --from=build /src/build/make-fixtures /make-fixtures
COPY --from=build /src/build/orientation-test /orientation-test
